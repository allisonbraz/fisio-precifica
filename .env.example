# ========================================
# FisioPrecifica — Environment Variables
# ========================================
# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL via Drizzle ORM) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fisio_precifica

# --- Supabase Auth ---
# Used by both client (VITE_ prefix) and server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Admin ---
# Email that receives admin role automatically on login
ADMIN_EMAIL=admin@example.com

# --- AI Features (optional, not currently active) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
