# ========================================
# FisioPrecifica — Environment Variables
# ========================================
# Copy this file to .env and fill in the values.

# --- Database (PostgreSQL via Drizzle ORM) ---
DATABASE_URL=postgresql://user:password@localhost:5432/fisio_precifica
# Conexão direta do Supabase, fora do pooler, usada só nas migrações.
# DIRECT_URL=postgresql://user:password@db.your-project.supabase.co:5432/postgres

# --- Supabase Auth ---
# Used by both client (VITE_ prefix) and server
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# --- Admin ---
# Email that receives admin role automatically on login
ADMIN_EMAIL=admin@example.com

# --- Error Monitoring (optional — Sentry) ---
# Get your DSN at https://sentry.io
SENTRY_DSN=
VITE_SENTRY_DSN=

# --- Analytics (optional — Umami) ---
# O script público só é carregado quando os dois valores existem.
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# --- AI Features (optional, not currently active) ---
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=
